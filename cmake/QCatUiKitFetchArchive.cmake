include_guard(GLOBAL)
function(qcat_fetch_archive url sha256 archive destination strip_root)
    get_filename_component(archive "${archive}" ABSOLUTE)
    get_filename_component(destination "${destination}" ABSOLUTE)
    get_filename_component(download_dir "${archive}" DIRECTORY)
    get_filename_component(destination_parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${download_dir}" "${destination_parent}")
    file(LOCK "${archive}.lock" GUARD FUNCTION TIMEOUT 600)
    file(LOCK "${destination}.lock" GUARD FUNCTION TIMEOUT 600)
    set(marker "${destination}/.qcat-archive-sha256")
    if(EXISTS "${marker}")
        file(READ "${marker}" current_hash)
        string(STRIP "${current_hash}" current_hash)
        if(current_hash STREQUAL sha256)
            return()
        endif()
    endif()
    set(valid FALSE)
    if(EXISTS "${archive}")
        file(SHA256 "${archive}" current_hash)
        if(current_hash STREQUAL sha256)
            set(valid TRUE)
        endif()
    endif()
    get_filename_component(name "${archive}" NAME)
    if(NOT valid)
        foreach(attempt RANGE 1 3)
            message(STATUS "Downloading ${name} (${attempt}/3)")
            file(DOWNLOAD "${url}" "${archive}.part" TLS_VERIFY ON
                TIMEOUT 600 INACTIVITY_TIMEOUT 60 STATUS status)
            list(GET status 0 code)
            if(code EQUAL 0)
                file(SHA256 "${archive}.part" current_hash)
                if(current_hash STREQUAL sha256)
                    file(RENAME "${archive}.part" "${archive}")
                    set(valid TRUE)
                    break()
                endif()
            endif()
        endforeach()
        if(NOT valid)
            file(REMOVE "${archive}.part")
            message(FATAL_ERROR "Cannot download/verify ${name}: ${status}. Check network/proxy or put the verified archive in ${download_dir}.")
        endif()
    endif()
    message(STATUS "Extracting verified ${name}")
    file(MAKE_DIRECTORY "${destination}")
    string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
    set(staging "${destination}/.qcat-extract-${nonce}")
    file(MAKE_DIRECTORY "${staging}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${staging}")
    if(strip_root)
        file(GLOB entries LIST_DIRECTORIES TRUE "${staging}/*")
        list(LENGTH entries count)
        if(NOT count EQUAL 1)
            message(FATAL_ERROR "Unexpected top-level layout in ${name}")
        endif()
        list(GET entries 0 top)
        if(NOT IS_DIRECTORY "${top}")
            message(FATAL_ERROR "Expected a root directory in ${name}")
        endif()
    else()
        set(top "${staging}")
    endif()
    file(COPY "${top}/" DESTINATION "${destination}")
    # Only remove the randomly named staging directory created inside this exact
    # destination, never a caller's source root or a shared dependency directory.
    cmake_path(IS_PREFIX destination "${staging}" NORMALIZE owned_staging)
    if(NOT owned_staging OR staging STREQUAL destination)
        message(FATAL_ERROR "Invalid archive staging directory")
    endif()
    file(REMOVE_RECURSE "${staging}")
    file(WRITE "${marker}" "${sha256}\n")
endfunction()
