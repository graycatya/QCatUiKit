# SPDX-License-Identifier: Apache-2.0
if(CONFIG STREQUAL "Debug")
    set(buildtype debug)
    set(optimization 0)
    set(vscrt mdd)
elseif(CONFIG STREQUAL "RelWithDebInfo")
    set(buildtype debugoptimized)
    set(optimization 2)
    set(vscrt md)
elseif(CONFIG STREQUAL "MinSizeRel")
    set(buildtype minsize)
    set(optimization s)
    set(vscrt md)
else()
    set(buildtype release)
    set(optimization 3)
    set(vscrt md)
endif()
set(options
    --backend=ninja --wrap-mode=nodownload
    "--prefix=${INSTALL_DIR}" --libdir=lib
    "--buildtype=${buildtype}" --default-library=static
    "-Doptimization=${optimization}" -Db_ndebug=if-release -Dstrip=false
    -Db_staticpic=true -Dstatic=true
    "-Dengines=${ENGINES}" -Dloaders=svg,lottie,ttf
    "-Dextra=[]" "-Dbindings=[]" "-Dsavers=[]" -Dtests=false)
file(READ "${SOURCE_DIR}/meson_options.txt" project_options)
if(project_options MATCHES "option\\('tools'")
    list(APPEND options "-Dtools=[]")
endif()
if(MSVC)
    set(ENV{VSLANG} 1033)
    list(APPEND options "-Db_vscrt=${vscrt}")
endif()
if(CROSS_FILE)
    list(APPEND options "--cross-file=${CROSS_FILE}")
endif()
if(EXISTS "${BUILD_DIR}/meson-private/coredata.dat")
    list(APPEND options --reconfigure)
endif()
string(REPLACE "|" ";" extra_options "${EXTRA_OPTIONS}")
if(QT_BIN_DIR AND EXISTS "${QT_BIN_DIR}")
    if(WIN32)
        set(ENV{PATH} "${QT_BIN_DIR};$ENV{PATH}")
    else()
        set(ENV{PATH} "${QT_BIN_DIR}:$ENV{PATH}")
    endif()
endif()
if(QSB_BIN_DIR AND EXISTS "${QSB_BIN_DIR}")
    if(WIN32)
        set(ENV{PATH} "${QSB_BIN_DIR};$ENV{PATH}")
    else()
        set(ENV{PATH} "${QSB_BIN_DIR}:$ENV{PATH}")
    endif()
endif()
string(REPLACE "|" ";" meson_command "${MESON}")
string(REPLACE "|" ";" cpp_command "${CXX_COMMAND}")
set(native "[binaries]\ncpp = [")
foreach(part IN LISTS cpp_command)
    string(REPLACE "\\" "/" part "${part}")
    string(REPLACE "'" "\\'" part "${part}")
    string(APPEND native "'${part}',")
endforeach()
string(APPEND native "]\n")
get_filename_component(build_parent "${BUILD_DIR}" DIRECTORY)
file(MAKE_DIRECTORY "${build_parent}")
file(WRITE "${BUILD_DIR}-native.ini" "${native}")
list(APPEND options "--native-file=${BUILD_DIR}-native.ini")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env "NINJA=${NINJA}"
    ${meson_command} setup "${BUILD_DIR}" "${SOURCE_DIR}" ${options} ${extra_options}
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "ThorVG Meson setup failed (${result})")
endif()
