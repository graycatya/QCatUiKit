foreach(mode IN ITEMS "--native-input" "--request-input-access")
    file(WRITE "${REPORT}" "{\"acceptance\":\"Passed\",\"inputAcceptance\":\"Passed\"}")
    execute_process(COMMAND "${PROBE}" ${mode} --report "${REPORT}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "Expected headless rejection, got ${result}: ${output} ${error}")
    endif()
    file(READ "${REPORT}" report)
    string(JSON acceptance GET "${report}" acceptance)
    string(JSON input GET "${report}" inputAcceptance)
    string(JSON count LENGTH "${report}" checks)
    string(JSON permission GET "${report}" postEventAccess)
    if(NOT acceptance STREQUAL "Pending" OR NOT input STREQUAL "Pending" OR count OR permission)
        message(FATAL_ERROR "Stale or invalid headless evidence: ${report}")
    endif()
endforeach()
